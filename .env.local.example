LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
GEMINI_API_KEY=
SHEET_CSV_URL=
# Optional: enables the admin-escalation notification feature.
# Add the bot to a LINE group; it replies with the group's ID to use here.
LINE_ADMIN_GROUP_ID=
# Optional: enables product price/stock lookup by bare product code.
# Published Google Sheet CSV with columns in this exact order (header row is skipped,
# wording doesn't matter): product code, product name, price, stock.
PRICE_SHEET_CSV_URL=
# Optional: enables multi-turn conversation memory (last 6 messages, 30-minute session).
# Set automatically when a Redis integration (e.g. "Redis" / "Official Redis for Vercel")
# is connected to the project via `vercel integration add redis`.
REDIS_URL=
